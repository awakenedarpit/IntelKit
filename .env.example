# ==============================================================================
# IntelKit — Environment Variables Template
# ==============================================================================
# Copy this file to ".env" for local development:
#   cp .env.example .env
# Never commit your real ".env" file or real API keys to GitHub.

# --- Application Settings ---
APP_ENV=development
LOG_LEVEL=INFO
PORT=8000

# --- Telegram Bot Configuration ---
# Get this token from @BotFather on Telegram.
TELEGRAM_BOT_TOKEN=

# Optional but recommended: a random secret string you choose to verify
# incoming webhook requests really come from Telegram.
TELEGRAM_WEBHOOK_SECRET=

# Public HTTPS URL of your server (e.g., ngrok URL locally, or Render URL later).
WEBHOOK_BASE_URL=

# --- AI Provider Configuration (Used starting in Stage 2) ---
PRIMARY_PROVIDER=groq
FALLBACK_PROVIDERS=gemini,openrouter

GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

